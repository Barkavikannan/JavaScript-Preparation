// intersection of two arrays

arr1=[1,2,3];
arr2=[2,3,4];
console.log(intersectionArray(arr1,arr2));

function intersectionArray(a1, a2){
    let newArray =[];
    
    let obj1={};
    let obj2={};
    
    for(let arr of a1){
        obj1[arr]=(obj1[arr]||0)+1;
    }
    for(let arr of a2){
        obj2[arr]=(obj2[arr]||0)+1;
    }
    
    for(let num in obj1){
        if(obj2[num]){
            newArray.push(Number(num));
        }
    }
    console.log(typeof(newArray));
    return newArray;
}


