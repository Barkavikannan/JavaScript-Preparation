//find missing number

function missedNum(arr){
    
    let initialNum = 1;
    
    for(let i = 0 ; i < arr.length ; i++){
       if( arr[i] !== initialNum ) {
            console.log("missed value:", initialNum);
            initialNum++;
       }
    initialNum++;
    }
}

let num=[1,2,4,5,7,8,10];

missedNum(num);
