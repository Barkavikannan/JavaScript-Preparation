// find fasy value in array

function removeFalsyValue(arr){
   let res=[];
   for(let i=0;i<arr.length;i++){
       if(arr[i]!==0 && arr[i]!==null && arr[i]!==false && arr[i]!==NaN && arr[i]!=="" && arr[i]!==undefined){
           res.push(arr[i]);
       }
   }
    console.log(res) ;
}

let input=[0,null,1,false,2]; 
removeFalsyValue(input);
